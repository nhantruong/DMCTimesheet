@* -------------------Chart summary Timesheet theo từng User *@
<script>
    var ctx = document.getElementById('SummaryWeeklyTS').getContext('2d');
    var lable = @Html.Raw(Json.Encode(memberName));
    var data =@Html.Raw(Json.Encode(memberHour));
   var myChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: lable,
            datasets: [{
                type: 'bar',
                label: 'Tổng số giờ đã điền: ',
                data: data,
                display: true,
                backgroundColor: 'rgba(128, 255, 128, 1)',
                borderColor:'rgba(0, 0, 0, 1)',
                borderWidth: 1,
                outerWidth: 0.3
            },
                {
                type: 'line',
                label: 'Tổng số giờ giới hạn trong tuần ',
                data: generateValue(data.length,44),
                display: true,
                backgroundColor: 'rgba(255, 0, 0, 1)',
                borderColor: 'rgba(0, 0, 0, 1)',
                borderWidth: 1,
                outerWidth: 0.3
            }
            ],

        },
       options: {
           responsive: true,
           legend: {
               position: 'bottom',
           },
           hover: {
               mode: 'label'
           },
           scales: {
               y: [{  
                   min:0, max: 44
               }]
           },
           showToolTips: true,
           plugins: {
               title: {
                   display: true,
                   position: 'top',
                   text: 'Chart 7 - Biểu đồ timesheet trong tuần theo thành viên',
                   position: 'bottom'
               },
               legend: {//ghi chú các thành phần trong biểu đồ
                   display: true,
                   position: 'bottom',
                   labels: {
                       color: 'rgb(0, 0, 0)'
                   }
               }
           }
       }
   });


    function generateValue(value,target) {
        var kq = [];
        for (var v = 0; v < value; v++) {
            kq.push(target);
        }
        return kq;
    }
</script>