<h5 class="text-center">Thông tin Dự án</h5>

<div class="col-md-12 row" style="height:700px">
    <div class="col-md-5">
        <div class="row" style="background-color:white;">
            <h5 class="text-center">Dự án đang triển khai của <b>@Members.Count()</b> thành viên</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-condensed">
                    <thead class="text-center">
                        <tr class="text-white" style="background-color:#808080">
                            <td class="col-md-4">Tên thành viên</td>
                            <td class="col-md-8">Tên dự án</td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="table-responsive" style="height:620px">
                <table class="table table-bordered table-hover table-condensed text-dark">
                    <tbody>
                        @if (AssignMemProjects == null || AssignMemProjects.Count() == 0)
                        {
                            <tr class="row">
                                <td>Chưa có thông tin</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in ProjectOfMember.OrderByDescending(s => s.Value.Count()))
                            {
                                if (item.Value.Count() != 0)
                                {
                                    string UserImg = "";
                                    if (Members.FirstOrDefault(s => s.UserID == item.Key).Image == null)
                                    {
                                        UserImg = NoimagePath;
                                    }
                                    else
                                    {
                                        UserImg = imgPath + @Members.FirstOrDefault(s => s.UserID == item.Key).Image;
                                    }
                                    <tr class="text-dark text-center row">
                                        <td class="col-md-4 text-center">
                                            <p>
                                                <img src="@UserImg" class="img-circle" alt="Alternate Text" style="height:50px; width:50px" />
                                            </p>
                                            <p class="">
                                                @Html.ActionLink(Members.FirstOrDefault(s => s.UserID == item.Key).FullName, "Details", "Member", new { Id = item.Key }, new { @class = "btn text-dark" })
                                            </p>
                                            <p class="inline">
                                                <h4 class="text-primary">@item.Value.Count()<small> dự án</small></h4>
                                            </p>
                                        </td>
                                        @*<td class="col-sm-2"><h3 class="text-danger">@item.Value.Count()</h3></td>*@
                                        <td class="col-md-8">
                                            <ol class="col">
                                                @foreach (var itm in item.Value.ToList())
                                                {
                                                    //int? st = Projects.FirstOrDefault(s => s.ProjectID == itm).ProjectStage;
                                                    //string stage = st != null ? ProjectStage.FirstOrDefault(s => s.Id == st).StageName : "*";
                                                    @*<li class="col-sm-6 text-left"><b>@Projects.FirstOrDefault(s => s.ProjectID == itm).ProjectOtherName</b>(<small class="text-danger">@stage</small>)</li>*@
                                                    <li class="col-sm-6 text-left"><b>@Projects.FirstOrDefault(s => s.ProjectID == itm).ProjectOtherName</b></li>
                                                }
                                            </ol>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
            @*<p class="text-danger">(*) dự án cho các công ty/ tổ chức thành viên</p>*@

        </div>
    </div>
    <div class="col-md-7" style="height:700px">
        <div class="row " style="background-color:white; height:350px">
            <h5 class="text-center">Danh sách <b>@ongoingP.Count()</b> dự án đang triển khai</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-condensed">
                    <thead class="table table-active">
                        <tr class="text-white" style="background-color:#808080">
                            <td class="col-md-1">Năm</td>
                            <td class="col-md-11">Tên dự án</td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="table-responsive" style="height:260px">
                <table class="table table-bordered table-hover table-condensed text-dark">
                    <tbody>
                        @foreach (var item in ongoingP)
                        {
                            int? st = item.ProjectStage;
                            string stage = st != null ? ProjectStage.FirstOrDefault(s => s.Id == st).StageName : "*";
                            <tr>
                                <td class="col-md-1">@item.Year</td>
                                <td class="col-md-11">@item.ProjectOtherName <small class="text-danger">(@stage)</small> </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
            <div class="text-center col-md-12">
                <p class="text-primary text-right"> (*) dự án cho các công ty/ tổ chức thành viên</p>
            </div>
        </div>
        <br />
        <div class="row " style="background-color:white; height:350px">
            <h5 class="text-center">Danh sách <b>@FinishP.Count()</b> Dự án đã hoàn tất</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-condensed">
                    <thead class="table table-active">
                        <tr class="text-white" style="background-color:#808080">
                            <td class="col-md-1">Năm</td>
                            <td class="col-md-11">Tên dự án</td>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="table-responsive" style="height:260px">
                <table class="table table-bordered table-condensed text-dark">
                    <tbody>
                        @foreach (var item in FinishP)
                        {
                            int? st = item.ProjectStage;
                            string stage = st != null ? ProjectStage.FirstOrDefault(s => s.Id == st).StageName : "*";
                            <tr>
                                <td class="col-md-1">@item.Year</td>
                                <td class="col-md-11">@item.ProjectName <small class="text-danger">(@stage)</small> </td>
                            </tr>

                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>

<div class="clearfix"></div>
<hr />
