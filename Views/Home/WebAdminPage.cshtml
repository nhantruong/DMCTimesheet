                <div class="row"><label class="chuto">@Projects.Count() </label><span class="chunho text-sm-right">Dự án (@Projects.OrderBy(s => s.Year).First().Year - @Projects.OrderByDescending(s => s.Year).First().Year)</</span></div>
            </div>
            <div class="col-md-8 text-primary">

            </div>
        </div>
    </div>
</div>

